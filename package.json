{
  "name": "cli-proxy-webui-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "lint": "oxlint --report-unused-disable-directives-severity=error",
    "verify": "bun run test && bun run lint && bun run build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@noble/hashes": "^2.4.0",
    "@uiw/react-codemirror": "^4.25.12",
    "axios": "1.21.1",
    "i18next": "^27.2.2",
    "motion": "^14.14.0",
    "motion-dom": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "overrides": {
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "brace-expansion": "5.0.12",
    "form-data": "4.0.6",
    "immutable": "5.1.9"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "1.94.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
